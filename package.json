{
  "name": "meraki-switch-ports-sdk",
  "version": "0.1.0",
  "description": "A focused TypeScript SDK for Cisco Meraki switch and switch-port operations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TDJR007/meraki-switch-ports-sdk"
  },
  "author": "Devansh Tanwar",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:live": "npm run build && node scripts/live-smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
